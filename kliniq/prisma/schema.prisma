// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  Patient
  CLinician
  Staff
}

enum Gender{
  Male
  Female
  Other
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AttachmentKind {
  LAB_RESULT
  SCAN
  PRESCRIPTION
  OTHER
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  passwordhash String
  role Role @default(Patient)
  is_active Boolean @default(true)
  created_at DateTime @default(now())
  patient PatientProfile?
  staff StaffProfile?

  appointments Appointment[]

  attachments Attachment[]
}

model PatientProfile {
  id Int @id @default(autoincrement())
  user_id Int @unique
  user User? @relation(fields: [user_id], references: [id], onDelete: Restrict)
  first_name String
  last_name String
  gender Gender
  date_of_birth DateTime
  phone          String
  address        String?
  nextOfKinName  String?
  nextOfKinPhone String?
  createdAt      DateTime @default(now())
  appointments Appointment[]
  notes        ClinicalNote[]
  attachments  Attachment[]

}

model StaffProfile {
  id                Int     @id @default(autoincrement())
  userId            Int     @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  title             String
  firstName         String
  lastName          String
  specialty         String?
  takesAppointments Boolean @default(false)
  scheduleRules      ScheduleRule[]
  scheduleExceptions ScheduleException[]
  appointments       Appointment[]
  notes              ClinicalNote[]
}


model ScheduleRule {
  id          Int          @id @default(autoincrement())
  clinicianId Int
  clinician   StaffProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  weekday     Int
  startMinute Int
  endMinute   Int
  slotMinutes Int          @default(20)
  validFrom   DateTime     @db.Date
  validTo     DateTime?    @db.Date

  //@@index([clinicianId, weekday])
}

model ScheduleException {
  id          Int          @id @default(autoincrement())
  clinicianId Int
  clinician   StaffProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  date        DateTime     @db.Date
  reason      String

  //@@unique([clinicianId, date])
}

model Appointment {
  id          Int               @id @default(autoincrement())
  patientId   Int
  patient     PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  clinicianId Int
  clinician   StaffProfile      @relation(fields: [clinicianId], references: [id], onDelete: Restrict)
  startsAt    DateTime          @db.Timestamptz(3)
  endsAt      DateTime          @db.Timestamptz(3)
  status      AppointmentStatus @default(BOOKED)
  reason      String?
  bookedById  Int
  bookedBy    User              @relation(fields: [bookedById], references: [id], onDelete: Restrict)
  cancelledAt DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  notes ClinicalNote[]

  @@index([clinicianId, startsAt])
  @@index([patientId, startsAt])
}

model ClinicalNote {
  id            Int            @id @default(autoincrement())
  appointmentId Int
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patientId     Int
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  authorId      Int
  author        StaffProfile   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body          String
  isFinal       Boolean        @default(false)
  amendsNoteId  Int?
  amendsNote    ClinicalNote?  @relation("NoteAmendments", fields: [amendsNoteId], references: [id], onDelete: Restrict)
  amendments    ClinicalNote[] @relation("NoteAmendments")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  attachments Attachment[]

  @@index([patientId, createdAt])
}

model Attachment {
  id           Int            @id @default(autoincrement())
  patientId    Int
  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  uploadedById Int
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  noteId       Int?
  note         ClinicalNote?  @relation(fields: [noteId], references: [id], onDelete: Restrict)
  kind         AttachmentKind
  storageKey   String         @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([patientId])
}

